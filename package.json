{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Mini servidor MCP para contexto de desenvolvimento",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node main.ts",
    "dev:watch": "nodemon --exec ts-node main.ts",
    "dev:compiled": "nodemon dist/main.js",
    "dev:auto": "nodemon",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "server",
    "context",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
