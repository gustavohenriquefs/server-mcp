{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Mini servidor MCP para contexto de desenvolvimento",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "node --loader ts-node/esm main.ts",
    "dev:watch": "nodemon --exec \"node --loader ts-node/esm main.ts\"",
    "dev:compiled": "nodemon dist/main.js",
    "dev:auto": "nodemon",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "server",
    "context",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
